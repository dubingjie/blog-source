<% if (page.total > 1) {
  const pageUrl = number => url_for(number === 1 ? (page.base || '') : (page.base || '') + config.pagination_dir + '/' + number + '/');
  const pageItems = (radius, showAllLimit) => {
    const selected = [];
    for (let number = 1; number <= page.total; number++) {
      if (page.total <= showAllLimit || number === 1 || number === page.total || Math.abs(number - page.current) <= radius) selected.push(number);
    }
    const items = [];
    selected.forEach((number, index) => {
      const previous = selected[index - 1];
      if (number - previous === 2) items.push(previous + 1);
      else if (number - previous > 2) items.push(null);
      items.push(number);
    });
    return items;
  };
%>
<nav class="linx-pager" aria-label="文章分页">
  <% if (page.prev) { %><a class="linx-pager-prev" href="<%= url_for(page.prev_link) %>" rel="prev">← 上一页</a><% } %>
  <% [{name: 'desktop', radius: 1, limit: 7}, {name: 'mobile', radius: 0, limit: 5}].forEach(view => { %>
  <span class="linx-pager-numbers linx-pager-<%= view.name %>">
    <% pageItems(view.radius, view.limit).forEach(number => { %>
      <% if (number === null) { %><span class="linx-pager-gap" aria-hidden="true">…</span>
      <% } else if (number === page.current) { %><span class="linx-pager-number is-current" aria-current="page" aria-label="第 <%= number %> 页，当前页"><%= number %></span>
      <% } else { %><a class="linx-pager-number" href="<%= pageUrl(number) %>" aria-label="第 <%= number %> 页"><%= number %></a><% } %>
    <% }); %>
  </span>
  <% }); %>
  <% if (page.next) { %><a class="linx-pager-next" href="<%= url_for(page.next_link) %>" rel="next">下一页 →</a><% } %>
</nav>
<% } %>
