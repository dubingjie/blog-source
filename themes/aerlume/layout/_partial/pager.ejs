<% if (page.total > 1) { %>
<nav class="linx-pager" aria-label="文章分页"><% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>" rel="prev">← 上一页</a><% } else { %><span></span><% } %><span><%= page.current %> / <%= page.total %></span><% if (page.next) { %><a href="<%= url_for(page.next_link) %>" rel="next">下一页 →</a><% } else { %><span></span><% } %></nav>
<% } %>
