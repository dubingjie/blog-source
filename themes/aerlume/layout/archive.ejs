<header class="page-heading"><p class="eyebrow">LEARNING JOURNAL</p><h1>归档</h1><p>共 <%= page.posts.length %> 篇笔记，每一步都算数。</p></header>
<% const groups = {}; page.posts.sort('date', -1).each(function(post) { const year = post.date.format('YYYY'); (groups[year] ||= []).push(post); }); %>
<% Object.keys(groups).sort().reverse().forEach(function(year) { %><section class="archive-year"><h2><%= year %></h2><ol><% groups[year].forEach(function(post) { %><li><time datetime="<%= post.date.toISOString() %>"><%= post.date.format('MM-DD') %></time><a data-post-link href="<%= url_for(post.path) %>"><%= post.title %></a></li><% }); %></ol></section><% }); %>
